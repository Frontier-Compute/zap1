UFVK=uview1...your_unified_full_viewing_key
NETWORK=Mainnet
ZEBRA_RPC_URL=http://127.0.0.1:8232
LISTEN_ADDR=127.0.0.1:3080
DB_PATH=/data/zap1.db
SCAN_FROM_HEIGHT=replace_with_wallet_birthday_height
# SIGNAL_NUMBER=+1234567890
# SIGNAL_API_URL=http://127.0.0.1:8080
API_KEY=your_secret_api_key_here

# Exact sha256 image ID from the verified scripts/build_image.sh receipt.
# Pass this file with docker compose --env-file so interpolation uses it too.
ZAP1_DEPLOYMENT_IMAGE_ID=sha256:replace_with_verified_image_id

# Public trial-key issuance is disabled unless an operator explicitly enables it.
TRIAL_KEY_ISSUANCE_ENABLED=false

# Signer or CLI presence alone never authorizes a transaction.
# Set to true only for an operator-authorized broadcast window.
ANCHOR_BROADCAST_ENABLED=false

# Default signer. Keep this value for production operation.
SIGNING_MODE=single_key

# The current FROST path is a local compatibility experiment only. One process
# holds ANCHOR_SEED and two long-term shares, so it does not provide independent
# threshold custody. The process rejects SIGNING_MODE=frost unless this exact
# non-production opt-in is true, NETWORK=Testnet, and both FROST_SHARE_PATH
# values are set. Mainnet activation is rejected.
EXPERIMENTAL_COLOCATED_FROST_ENABLED=false
# FROST_SHARE_PATH_2=/secure/path/share-2.json
# FROST_SHARE_PATH_3=/secure/path/share-3.json
